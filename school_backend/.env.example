# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Number of reverse proxies in front of the app (nginx = 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY=0
# Requests per minute per client IP. Everyone in the school office usually shares ONE public IP — size it for that.
API_RATE_LIMIT_PER_MIN=600
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgres://school_app:change-me@localhost:5432/school_sms
DB_POOL_MAX=10
# TLS to the database — required in production when the DB is not on localhost
DB_SSL=false

# ---- Security ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_ACCESS_TTL=15m
JWT_ISSUER=school-sms
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://portal.school.edu.np
# Set to false only for local http development
COOKIE_SECURE=true
